# ======================================================
# RENDEREXPO AI STUDIO - ENVIRONMENT TEMPLATE
# Copy this to `.env` for local or GPU environments.
# NEVER commit your real HF_TOKEN to Git.
# ======================================================

# Hugging Face token (required for SD3.5 + LoRAs on GPU)
HF_TOKEN=""

# Model directory inside container (GPU mode)
SD35_MODEL_DIR="/workspace/models/sd35-large"

# Where outputs will be stored
OUTPUTS_ROOT="/workspace/outputs"

# Device for GPU runtime
SD_DEVICE="cuda"

# CORS (Wix domain will be added later)
CORS_ALLOW_ORIGINS="*"
